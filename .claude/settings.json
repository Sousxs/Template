{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(npx repomix:*)",
      "Bash(npx -y repomix:*)",
      "Bash(npx ccusage:*)",
      "Bash(npx -y ccusage:*)",
      "Bash(npx ccusage@latest:*)",
      "Bash(code-review-graph detect-changes:*)",
      "Bash(code-review-graph update:*)",
      "Bash(pwsh -NoProfile -File .specify/scripts/powershell/check-traceability.ps1:*)",
      "Bash(ocr session:*)",
      "Bash(ocr delegate preview:*)"
    ],
    "deny": [
      "Read(.specify/memory/codebase-snapshot.xml)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || echo 'Not a git repo, skipping'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
